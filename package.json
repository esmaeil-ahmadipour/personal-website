{
  "name": "tarvix-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "dev:diff": "git add . && node scripts/diff-to-clipboard.cjs",
    "build": "pnpm validate:env && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next node_modules",
    "db:generate": "prisma generate",
    "content:import": "tsx prisma/content/import-cli.ts",
    "content:force-token": "tsx prisma/content/import-cli.ts token",
    "db:init:dev": "tsx prisma/seed.ts && tsx prisma/content/import-cli.ts --all",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed:dev": "tsx prisma/seed-dev.ts",
    "db:init:demo": "pnpm db:init:dev && pnpm db:seed:dev",
    "test:db": "tsx --test prisma/__tests__/*.test.ts",
    "test:db:unit": "tsx --test prisma/__tests__/*.unit.test.ts",
    "content:validate": "tsx prisma/content/cli.ts",
    "content:approve": "tsx prisma/content/approve-cli.ts",
    "content:adopt": "tsx prisma/content/adopt-cli.ts",
    "release": "tsx scripts/release.ts",
    "release:dry": "tsx scripts/release.ts --dry-run",
    "db:studio": "prisma studio",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:down": "docker-compose -f docker-compose.yml down",
    "docker:restart": "docker-compose -f docker-compose.yml restart",
    "db:wait": "until docker exec tarvix-postgres pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"; do echo 'Waiting for database...'; sleep 1; done",
    "db:start": "pnpm docker:up && pnpm db:wait && pnpm db:push",
    "db:reset": "pnpm docker:down && docker volume rm tarvix-nextjs_postgres-data 2>/dev/null || true && pnpm docker:up && sleep 5 && pnpm db:wait && pnpm db:push && pnpm db:seed",
    "postinstall": "prisma generate",
    "validate:env": "node -r ts-node/register -r dotenv/config scripts/validate-env.ts",
    "generate:secret": "node -e \"console.log(crypto.randomBytes(32).toString('hex'))\"",
    "security:check": "pnpm validate:env && pnpm lint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "5.22.0",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "next": "16.2.4",
    "next-intl": "^4.13.0",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.13.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "marked": "^18.0.10",
    "pg": "^8.16.0",
    "postcss": "^8.5.15",
    "prisma": "^5.22.0",
    "sanitize-html": "^2.14.0",
    "tailwindcss": "^4.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vercel": "^66.6.0",
    "yaml": "^2.9.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
