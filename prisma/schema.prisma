// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RequestAccess {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fullName        String
  email           String
  role            String?
  company         String?
  githubUsername  String
  preferredStack  String   @default("flutter")
  message         String?
  status          String   @default("pending")

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

// prisma/schema.prisma

model Contact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fullName  String
  email     String
  service   String
  message   String
  status    String   @default("pending")

  @@index([email])
  @@index([status])
  @@index([createdAt])
}



enum PostStatus {
  draft
  pending
  published
}

model Author {
  id        String   @id @default(cuid())
  slug      String   @unique
  email     String?  @unique
  avatarUrl String?
  
  firstNameEn String
  lastNameEn  String
  bioEn       String?
  
  firstNameFa String
  lastNameFa  String
  bioFa       String?
  
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([createdAt])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  
  nameEn      String
  descriptionEn String?
  
  nameFa      String
  descriptionFa String?
  
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([createdAt])
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  
  nameEn    String
  nameFa    String
  
  posts     PostTag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([createdAt])
}

model Post {
  id             String      @id @default(cuid())
  slug           String      @unique
  
  titleEn        String
  excerptEn      String?
  contentEn      String
  seoTitleEn     String?
  seoDescriptionEn String?
  
  titleFa        String
  excerptFa      String?
  contentFa      String
  seoTitleFa     String?
  seoDescriptionFa String?
  
  coverImageUrl  String?
  readingTimeMin Int?
  status         PostStatus  @default(draft)
  publishedAt    DateTime?
  
  views          Int         @default(0)  

  authorId       String
  categoryId     String

  author         Author      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category       Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags           PostTag[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@index([slug])
  @@index([status, publishedAt])
}

model PostTag {
  postId     String
  tagId      String
  assignedAt DateTime @default(now())

  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag        Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@index([assignedAt])
}
