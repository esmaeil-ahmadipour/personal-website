// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Release tracking
// System-owned tables written only by the seed and content-import tooling.
// Application code must never read or write them at request time.
// ---------------------------------------------------------------------------

enum SeedStatus {
  running
  succeeded
  failed
}

// One row per system seed version (prisma/seed/versions/*).
// A version is considered applied only when status = succeeded.
model SeedHistory {
  id          String     @id @default(cuid())
  version     String     @unique // e.g. "v1.0.0"
  status      SeedStatus @default(running)
  attempts    Int        @default(1)
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  error       String?
  gitSha      String?
  environment String?
}

// One row per file-managed content item (e.g. a post imported from Markdown).
// Stores what the importer last wrote so later imports can tell file changes
// apart from administrator edits.
model ContentSync {
  id                  String   @id @default(cuid())
  kind                String   @default("post")
  slug                String
  sourceHash          String // hash of the source files + importer format version
  fieldHashes         Json     @default("{}") // field name -> hash of the last imported value
  consumedForceTokens String[] @default([]) // "force:<token>" / "recreate:<token>"
  formatVersion       Int
  importedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([kind, slug])
}

model RequestAccess {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fullName        String
  email           String
  role            String?
  company         String?
  githubUsername  String
  preferredStack  String   @default("flutter")
  message         String?
  status          String   @default("pending")

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model Contact {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fullName  String
  email     String
  service   String
  message   String
  status    String   @default("pending")

  @@index([email])
  @@index([status])
  @@index([createdAt])
}

enum PostStatus {
  draft
  pending
  published
}

model Author {
  id        String   @id @default(cuid())
  slug      String   @unique
  email     String?  @unique
  avatarUrl String?
  
  // Social links - NEW
  twitter   String?
  github    String?
  website   String?
  linkedin  String?
  
  // انگلیسی
  firstNameEn String
  lastNameEn  String
  bioEn       String?
  roleEn      String?   // job title, e.g. "Software Engineer"
  
  // فارسی
  firstNameFa String
  lastNameFa  String
  bioFa       String?
  roleFa      String?
  
  // عربی 🇸🇦
  firstNameAr String @default("")
  lastNameAr  String @default("")
  bioAr       String @default("")
  roleAr      String @default("")
  
  posts     Post[]
  newsletterIssues NewsletterIssue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([createdAt])
  @@index([email])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  
  // Order and hierarchy - NEW
  order       Int      @default(0)
  parentId    String?  @map("parent_id")
  isActive    Boolean  @default(true)
  
  // انگلیسی
  nameEn      String
  descriptionEn String?
  
  // فارسی
  nameFa      String
  descriptionFa String?
  
  // عربی 🇸🇦
  nameAr      String @default("")
  descriptionAr String @default("")
  
  posts       Post[]
  newsletterIssues NewsletterIssue[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([createdAt])
  @@index([parentId])
  @@index([isActive])
  @@index([order])
}

model Tag {
  id        String   @id @default(cuid())
  slug      String   @unique
  
  // UI fields - NEW
  color     String?  @default("#3b82f6")
  icon      String?  // Icon name from Lucide or similar
  
  // انگلیسی
  nameEn    String
  
  // فارسی
  nameFa    String
  
  // عربی 🇸🇦
  nameAr    String @default("")
  
  posts     PostTag[]
  newsletterIssues NewsletterIssueTag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([createdAt])
  @@index([color])
}

model Post {
  id             String      @id @default(cuid())
  slug           String      @unique
  
  // Meta fields - NEW
  isFeatured     Boolean     @default(false)
  isTrending     Boolean     @default(false)
  isPinned       Boolean     @default(false)
  priority       Int         @default(0)  // For custom ordering
  language       String?     @default("en")  // "en", "fa", "ar"
  
  // انگلیسی
  titleEn        String
  excerptEn      String?
  contentEn      String
  seoTitleEn     String?
  seoDescriptionEn String?
  keywordsEn     String?  // NEW - SEO keywords
  ogImageEn      String?  // NEW - Open Graph image
  
  // فارسی
  titleFa        String
  excerptFa      String?
  contentFa      String
  seoTitleFa     String?
  seoDescriptionFa String?
  keywordsFa     String?  // NEW - SEO keywords
  ogImageFa      String?  // NEW - Open Graph image
  
  // عربی 🇸🇦
  titleAr        String @default("")
  excerptAr      String @default("")
  contentAr      String @default("")
  seoTitleAr     String @default("")
  seoDescriptionAr String @default("")
  keywordsAr     String?  // NEW - SEO keywords
  ogImageAr      String?  // NEW - Open Graph image
  
  coverImageUrl  String?
  readingTimeMin Int?
  status         PostStatus  @default(draft)
  publishedAt    DateTime?
  
  views          Int         @default(0)
  likes          Int         @default(0)  // NEW - Like count
  comments       Int         @default(0)  // NEW - Comment count
  
  // Author and Category relations
  authorId       String
  categoryId     String

  author         Author      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category       Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags           PostTag[]
  projects       ProjectPost[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([authorId])
  @@index([categoryId])
  @@index([slug])
  @@index([status, publishedAt])
  @@index([isFeatured])    // NEW
  @@index([isTrending])    // NEW
  @@index([language])      // NEW
  @@index([priority])
  @@index([views])
}

model PostTag {
  postId     String
  tagId      String
  assignedAt DateTime @default(now())

  post       Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag        Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@index([assignedAt])
}

// ---------------------------------------------------------------------------
// Projects (showcase). Replaces the static list in features/projects/data.
// ---------------------------------------------------------------------------

enum ProjectKind {
  research // Product Research
  tool     // Tools & Engineering
}

enum ProjectStage {
  prototype
  preProduction
  live
  openSource
  archived
}

// Extra labels shown in the project meta line. Names are translated in translations/*.json.
enum ProjectBadge {
  personal
  blockchain
  desktop
}

model Project {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String       // brand name, not translated

  // English is required; a missing Fa/Ar text falls back to English in the UI
  descriptionEn String
  descriptionFa String       @default("")
  descriptionAr String       @default("")
  overviewEn    String?
  overviewFa    String?
  overviewAr    String       @default("")

  isFeatured    Boolean      @default(false)
  order         Int          @default(0)
  coverImageUrl String?

  kind          ProjectKind
  stage         ProjectStage @default(prototype)
  year          Int?
  badges        ProjectBadge[] @default([]) // shown in array order
  stack         String[]     @default([])

  url           String?      // live project
  sourceUrl     String?      // source repository

  status        PostStatus   @default(draft)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  posts         ProjectPost[]

  @@index([status, order])
  @@index([isFeatured])
  @@index([kind])
  @@index([stage])
}

// Optional link between a project and blog posts (a project may have none).
model ProjectPost {
  projectId  String
  postId     String
  assignedAt DateTime @default(now())

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([projectId, postId])
  @@index([postId])
}

// ---------------------------------------------------------------------------
// Newsletter issues. Published on LinkedIn; the full text is also readable on
// the site in en/fa/ar. Uses the same Category and Tag tables as blog posts.
// ---------------------------------------------------------------------------

model NewsletterIssue {
  id             String      @id @default(cuid())
  number         Int         @unique
  linkedinUrl    String      // original publication

  // English
  titleEn        String
  excerptEn      String?
  contentEn      String

  // Persian
  titleFa        String
  excerptFa      String?
  contentFa      String

  // Arabic
  titleAr        String      @default("")
  excerptAr      String      @default("")
  contentAr      String      @default("")

  coverImageUrl  String?
  readingTimeMin Int?
  status         PostStatus  @default(draft)
  publishedAt    DateTime?

  authorId       String
  categoryId     String
  author         Author      @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category       Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags           NewsletterIssueTag[]

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
  @@index([categoryId])
}

model NewsletterIssueTag {
  issueId    String
  tagId      String
  assignedAt DateTime @default(now())

  issue      NewsletterIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  tag        Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([issueId, tagId])
  @@index([tagId])
}
